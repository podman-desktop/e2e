# make oci-build builds this base locally first; no published runner is needed.
ARG CODEX_RUNNER_IMAGE=localhost/codex-runner:v0.1.0
FROM ${CODEX_RUNNER_IMAGE}

LABEL org.opencontainers.image.title="Podman Desktop E2E evaluation agent" \
      org.opencontainers.image.description="Headless Codex evaluation of Podman Desktop E2E artifacts"

USER 0
COPY .skills/evaluate-e2e-results /etc/codex/skills/evaluate-e2e-results
COPY --chmod=0755 evaluation-agent/entrypoint.sh /usr/local/bin/evaluate-e2e-results
RUN chmod -R a+rX /etc/codex/skills
USER 1001
ENTRYPOINT ["/usr/local/bin/evaluate-e2e-results"]
