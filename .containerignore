# Build context for evaluation-agent/Containerfile is the repository root, so
# that the `COPY .skills/...` resolves. Only two paths are ever copied, so deny
# everything and re-include just those: the context stays small, and a local
# build artifact (node_modules, __pycache__, Playwright output) can never be
# picked up by a COPY.
*
!.skills
!evaluation-agent/entrypoint.sh

# Re-applied after the includes above — later rules win — so compiled Python
# inside .skills/ is still excluded.
__pycache__/
*.pyc
